# Sao chép thành .env (KHÔNG commit .env). Mọi biến đều có giá trị mặc định cho dev,
# nên prototype chạy được cả khi chưa có file .env.

# Cơ sở dữ liệu PostgreSQL 16 (ADR-0004), chạy bằng Docker: docs/04-guides/dev-setup.md mục 4.
DATABASE_URL=postgresql+psycopg://postcare:postcare@localhost:5432/postcare
# DB riêng cho pytest (F01): tên phải kết thúc bằng _test, KHÔNG trùng DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://postcare:postcare@localhost:5432/postcare_test

# Xác thực (đổi khi chạy demo; nên dài ≥ 32 ký tự)
JWT_SECRET=change-me-to-a-long-random-string-32b
JWT_EXPIRE_HOURS=8

# Token cho worker / giả lập gọi /internal/v1/*
WORKER_TOKEN=change-me-worker

# Worker / giả lập -> API
API_BASE_URL=http://127.0.0.1:8000

# Hiển thị thời gian trên UI
TZ_DISPLAY=Asia/Ho_Chi_Minh

# CORS khi mở web không qua proxy Vite (nhiều origin cách nhau bằng dấu phẩy)
WEB_ORIGINS=http://localhost:5173

# Mật khẩu cho tài khoản seed nurse/charge/doctor/admin (chỉ dùng khi dev/demo)
SEED_PASSWORD=postcare

# Camera chuyển "Mất kết nối" sau số giây không có heartbeat (A02)
CAMERA_OFFLINE_AFTER_S=5
